<div class="chat-room">
  <h1 class="chat-room__title"><%= @chat_session.title || "チャット" %></h1>
  <div class="chat-room__back">
    <%= link_to "チャット一覧に戻る", chat_sessions_path, class: "btn" %>
  </div>
  <div id="messages" class="chat-room__messages">
    <%= render @chat_messages %>
  </div>
  <%= form_with url: chat_session_chat_messages_path(@chat_session),
                method: :post,
                data: { turbo_stream: true },
                html: { class: "chat-room__form" } do |f| %>
    <div class="chat-room__input-area">
      <%= f.text_field :content,
            class: "chat-room__input",
            placeholder: "メッセージを入力..." %>
      <%= f.submit "送信", class: "chat-room__submit" %>
    </div>
  <% end %>
</div>
<script>
  document.addEventListener("turbo:render", () => {
    const messages = document.getElementById("messages");
    messages.scrollTop = messages.scrollHeight;
  });
</script>
