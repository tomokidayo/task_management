<h1>タスク一覧</h1>
<!-- 検索・フィルター -->
<div class="search-form">
  <%= form_with url: tasks_path, method: :get, local: true do |f| %>
    <div>
      <%= f.label :keyword, "キーワード検索" %>
      <%= f.text_field :keyword, value: params[:keyword] %>
    </div>
    <div>
      <%= f.label :status, "ステータス" %>
      <%= f.select :status,
            Task::STATUS_LABELS.map { |key, label| [label, key] },
            { include_blank: "すべて" },
            { selected: params[:status] } %>
    </div>
    <div>
      <%= f.label :priority, "優先度" %>
      <%= f.select :priority,
            Task::PRIORITY_LABELS.map { |key, label| [label, key] },
            { include_blank: "すべて" },
            { selected: params[:priority] } %>
    </div>
    <div>
      <%= f.submit "検索", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
<!-- 新規作成 -->
<div class="actions">
  <%= link_to "新規タスク", new_task_path, class: "btn btn-primary" %>
</div>
<!-- 一覧 -->
<table class="task-table">
  <thead>
    <tr>
      <th>タイトル</th>
      <th>
        <%= link_to "ステータス",
          tasks_path(
            keyword: params[:keyword],
            status: params[:status],
            priority: params[:priority],
            sort: "status",
            direction: params[:direction] == "asc" ? "desc" : "asc"
          ) %>
      </th>
      <th>
        <%= link_to "優先度",
          tasks_path(
            keyword: params[:keyword],
            status: params[:status],
            priority: params[:priority],
            sort: "priority",
            direction: params[:direction] == "asc" ? "desc" : "asc"
          ) %>
      </th>
      <th>
        <%= link_to "締切",
          tasks_path(
            keyword: params[:keyword],
            status: params[:status],
            priority: params[:priority],
            sort: "deadline",
            direction: params[:direction] == "asc" ? "desc" : "asc"
          ) %>
      </th>
      <th>
        <%= link_to "想定時間",
          tasks_path(
            keyword: params[:keyword],
            status: params[:status],
            priority: params[:priority],
            sort: "estimated_time",
            direction: params[:direction] == "asc" ? "desc" : "asc"
          ) %>
      </th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td>
          <%= form_with url: update_status_task_path(task), method: :patch, local: true do |f| %>
            <%= f.select :status,
              Task::STATUS_LABELS.map { |key, value| [value, key] },
              { selected: task.status } %>
            <%= f.submit "変更", class: "btn btn-sm" %>
          <% end %>
        </td>
        <td><%= Task::PRIORITY_LABELS[task.priority] %></td>
        <td><%= task.deadline&.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= task.estimated_time_hhmm %></td>
        <td class="actions">
          <%= link_to "詳細", task_path(task), class: "btn btn-sm" %>
          <%= link_to "編集", edit_task_path(task), class: "btn btn-sm" %>
          <%= button_to "削除", task_path(task),
                method: :delete,
                form: { style: "display:inline;" },
                data: { turbo_confirm: "本当に削除しますか？" },
                class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
