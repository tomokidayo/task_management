<h1>タスク作成</h1>
<%= form_with model: @task do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :description, "詳細" %><br>
    <%= f.text_area :description %>
  </div>
  <div>
    <%= f.label :status, "ステータス" %><br>
    <%= f.select :status, ["未着手", "進行中", "完了"] %>
  </div>
  <div>
    <%= f.label :priority, "優先度" %><br>
    <%= f.number_field :priority %>
  </div>
  <div>
    <%= f.label :deadline, "締切" %><br>
    <%= f.datetime_field :deadline %>
  </div>
  <div>
    <%= f.label :estimated_time, "想定時間（h）" %><br>
    <%= f.number_field :estimated_time %>
  </div>
  <div>
    <%= f.label :actual_time, "実績時間（h）" %><br>
    <%= f.number_field :actual_time %>
  </div>
  <%= f.submit "作成" %>
<% end %>
