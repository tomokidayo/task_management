<h1 class="task-form__title">タスク作成</h1>
<%= form_with model: @task, html: { class: "task-form" } do |f| %>
  <%= render "shared/error_messages", object: @task %>
  <div class="task-form__group">
    <%= f.label :title, "タイトル", class: "task-form__label" %>
    <%= f.text_field :title, class: "task-form__input" %>
  </div>
  <div class="task-form__group">
    <%= f.label :description, "詳細", class: "task-form__label" %>
    <%= f.text_area :description, class: "task-form__textarea" %>
  </div>
  <div class="task-form__group">
    <%= f.label :status, "ステータス", class: "task-form__label" %>
    <%= f.select :status,
          Task::STATUS_LABELS.map { |key, label| [label, key] },
          {},
          class: "task-form__select" %>
  </div>
  <div class="task-form__group">
    <%= f.label :priority, "優先度", class: "task-form__label" %>
    <%= f.select :priority,
          Task::PRIORITY_LABELS.map { |key, label| [label, key] },
          { selected: @task.priority },
          class: "task-form__select" %>
  </div>
  <div class="task-form__group">
    <%= f.label :deadline, "締切", class: "task-form__label" %>
    <%= f.datetime_field :deadline, class: "task-form__input" %>
  </div>
  <div class="task-form__group">
    <%= f.label :estimated_time, "想定時間（分）", class: "task-form__label" %>
    <%= f.number_field :estimated_time, class: "task-form__input" %>
  </div>
  <div class="task-form__group">
    <%= f.label :actual_time, "実績時間（分）", class: "task-form__label" %>
    <%= f.number_field :actual_time, class: "task-form__input" %>
  </div>
  <div class="task-form__actions">
    <%= f.submit "作成", class: "btn btn-primary" %>
    <%= link_to "戻る", tasks_path, class: "btn" %>
  </div>
<% end %>
