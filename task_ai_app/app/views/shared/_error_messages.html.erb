<% if object.errors.any? %>
  <div class="form-errors">
    <p class="form-errors__title">
      <%= object.errors.count %>件のエラーがあります
    </p>
    <ul class="form-errors__list">
      <% object.errors.each do |error| %>
        <li class="form-errors__item"><%= error.message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
