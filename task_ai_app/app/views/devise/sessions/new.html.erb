<h2 class="login-title">Log in</h2>
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form" }) do |f| %>
  <div class="login-form__group">
    <%= f.label :email, class: "login-form__label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "login-form__input" %>
  </div>
  <div class="login-form__group">
    <%= f.label :password, class: "login-form__label" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "login-form__input" %>
  </div>
  <% if devise_mapping.rememberable? %>
    <div class="login-form__group login-form__group--checkbox">
      <%= f.check_box :remember_me, class: "login-form__checkbox" %>
      <%= f.label :remember_me, class: "login-form__label login-form__label--checkbox" %>
    </div>
  <% end %>
  <div class="login-form__actions">
    <%= f.submit "Log in", class: "login-form__submit" %>
  </div>
<% end %>
<%= render "devise/shared/links" %>
