<h2 class="signup-title">新規登録</h2>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "signup-form" }) do |f| %>
  <%= render "shared/error_messages", object: resource %>
  <div class="signup-form__group">
    <%= f.label :name,"ユーザー名", class: "signup-form__label" %>
    <%= f.text_field :name, class: "signup-form__input" %>
  </div>
  <div class="signup-form__group">
    <%= f.label :email,"メールアドレス", class: "signup-form__label" %>
    <%= f.email_field :email, class: "signup-form__input" %>
  </div>
  <div class="signup-form__group">
    <%= f.label :password,"パスワード", class: "signup-form__label" %>
    <% if @minimum_password_length %>
      <p class="signup-form__note"><%= @minimum_password_length %> 文字以上で設定してください。</p>
    <% end %>
    <%= f.password_field :password, class: "signup-form__input" %>
  </div>
  <div class="signup-form__group">
    <%= f.label :password_confirmation,"パスワード（確認用)", class: "signup-form__label" %>
    <%= f.password_field :password_confirmation, class: "signup-form__input" %>
  </div>
  <div class="signup-form__actions">
    <%= f.submit "Sign up", class: "signup-form__submit" %>
  </div>
<% end %>
